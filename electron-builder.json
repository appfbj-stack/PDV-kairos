{
  "appId": "com.kairospdv.app",
  "productName": "Kairós PDV",
  "executableName": "KairosPDV",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/main.cjs",
    "electron/preload.cjs",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "requestedExecutionLevel": "asInvoker"
  },
  "nsis": {
    "artifactName": "KairosPDV-Setup-${version}.${ext}",
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Kairós PDV",
    "uninstallDisplayName": "Kairós PDV - Ponto de Venda",
    "deleteAppDataOnUninstall": false
  },
  "portable": {
    "artifactName": "KairosPDV-${version}-Portable.${ext}"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "appfbj-stack",
      "repo": "PDV-kairos"
    }
  ]
}
